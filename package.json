{
  "name": "fman",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "changelog": "bun tools/commits/changelog.ts",
    "changelog:release": "bun tools/commits/changelog.ts release",
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "baseline": "bun tools/bots/cli.ts baseline",
    "baseline:compare": "bun tools/bots/cli.ts compare",
    "typecheck": "tsc --noEmit && bun run --cwd web typecheck",
    "test": "bun test tools && bun run --cwd web test",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun tools/preflight.ts && bun run typecheck && bun run lint && bun run format:check && bun run test",
    "zx:link": "bun tools/zx/link-roms.ts",
    "zx:extract": "bun tools/zx/extract.ts 'roms/zx/Football Manager - Players (1982)(Addictive Games).z80'",
    "zx:snapshot": "uv run --with skoolkit==10.2 tap2sna.py 'roms/zx/Football Manager.tzx' roms/zx/analysis/local-original.z80",
    "zx:observe": "bun tools/zx/observe.ts roms/zx/analysis/local-original.z80 roms/zx/analysis fresh",
    "zx:timing": "bun tools/zx/capture-timing.ts tools/zx/inputs/timing.json",
    "zx:timing:clock": "bun tools/zx/capture-timing.ts --verify-clock build/zx/timing-clock.json"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nkzw/eslint-config": "^3.3.0",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
