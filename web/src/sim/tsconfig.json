{
  // The simulation is headless: no DOM and no Bun globals, so using either here
  // fails the typecheck. ESLint rejects imports from outside web/src/sim.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["./**/*.ts"],
  "exclude": ["./**/*.test.ts"]
}
